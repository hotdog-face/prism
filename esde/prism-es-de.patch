+template <typename T>
+void TextListComponent<T>::renderFavoriteBurst(const glm::mat4& rowTrans, float rowHeight, float p)
+{
+    // Redraw palette: pink, orange, yellow, lime, cyan, blue.
+    static const unsigned int colors[] {0xF0436F00, 0xF69F3C00, 0xFBE01A00, 0xB6D35100,
+                                        0x27B6D500, 0x29ABEB00, 0xF0436F00, 0xFBE01A00};
+    if (!mBurstStar) {
+        mBurstStar = std::make_unique<TextComponent>("\xef\x80\x85", mFont, 0xFFFFFFFF);
+        mBurstStar->setOrigin(0.5f, 0.5f);
+    }
+    auto ease = [](float x) {
+        x = glm::clamp(x, 0.0f, 1.0f);
+        return 1.0f - (1.0f - x) * (1.0f - x) * (1.0f - x);
+    };
+    const float fs {mFont->getSize()};
+    // Centred on the favorite star marker at the start of the title.
+    const glm::vec2 c {fs * 0.42f, rowHeight * 0.5f};
+
+    // Sparks: eight small stars flying out, spinning and fading.
+    const float sparkAlpha {glm::clamp(1.0f - p * 1.15f, 0.0f, 1.0f)};
+    for (int i {0}; i < 8; ++i) {
+        const float a {glm::radians(i * 45.0f + 22.5f)};
+        const float d {fs * (0.9f + 2.2f * ease(p * 1.6f))};
+        mBurstStar->setColor(colors[i] | static_cast<unsigned int>(sparkAlpha * 255.0f));
+        mBurstStar->setPosition(c.x + std::cos(a) * d, c.y + std::sin(a) * d * 0.8f, 0.0f);
+        mBurstStar->setScale(0.42f * (1.0f - 0.5f * p));
+        mBurstStar->setRotationDegrees(p * 220.0f + i * 20.0f);
+        mBurstStar->render(rowTrans);
+    }
+
+    // Hero star: pops in big over the marker, spins and settles onto it, then fades out.
+    // Visible at once (no grow-from-zero), quick overshoot, then settles onto the marker.
+    const float pop {p < 0.12f ? 1.6f + 0.7f * ease(p / 0.12f) : 2.3f - 1.3f * ease((p - 0.12f) / 0.4f)};
+    const float heroAlpha {p < 0.7f ? 1.0f : glm::clamp(1.0f - (p - 0.7f) / 0.3f, 0.0f, 1.0f)};
+    mBurstStar->setColor(0xFBE01A00 | static_cast<unsigned int>(heroAlpha * 255.0f));
+    mBurstStar->setPosition(c.x, c.y, 0.0f);
+    mBurstStar->setScale(pop);
+    mBurstStar->setRotationDegrees((1.0f - ease(p / 0.6f)) * -90.0f);
+    mBurstStar->render(rowTrans);
+}
+
