diff --git a/es-core/src/FavoriteBurst.h b/es-core/src/FavoriteBurst.h
new file mode 100644
index 0000000..7e6d06b
--- /dev/null
+++ b/es-core/src/FavoriteBurst.h
@@ -0,0 +1,43 @@
+//  SPDX-License-Identifier: MIT
+//
+//  Prism patch (2026-10-08): star burst on a game's title in the list when it is marked as favorite.
+//  GamelistBase triggers it with the game's path, TextListComponent draws it on that row while it runs.
+//
+
+#ifndef ES_CORE_FAVORITE_BURST_H
+#define ES_CORE_FAVORITE_BURST_H
+
+#include <SDL2/SDL_timer.h>
+#include <string>
+
+namespace FavoriteBurst
+{
+    inline std::string sKey;
+    inline unsigned int sStart {0};
+    constexpr float DURATION {1150.0f};
+
+    // The clock starts on the first frame that draws the burst: re-sorting and repopulating the list after
+    // the favorite toggle takes a moment, and starting earlier would eat the pop-in.
+    inline void trigger(const std::string& key)
+    {
+        sKey = key;
+        sStart = 0;
+    }
+
+    // 0..1 while the burst runs, -1 when idle.
+    inline float progress()
+    {
+        if (sKey.empty())
+            return -1.0f;
+        if (sStart == 0)
+            sStart = SDL_GetTicks();
+        const float t {static_cast<float>(SDL_GetTicks() - sStart) / DURATION};
+        if (t >= 1.0f) {
+            sKey.clear();
+            return -1.0f;
+        }
+        return t;
+    }
+} // namespace FavoriteBurst
+
+#endif // ES_CORE_FAVORITE_BURST_H
