  <system>
    <name>n3ds</name>
    <fullname>Nintendo 3DS</fullname>
    <path>%ROMPATH%/n3ds</path>
    <extension>.3ds .3DS .3dsx .3DSX .app .APP .axf .AXF .cci .CCI .cxi .CXI .elf .ELF .7z .7Z .zip .ZIP</extension>
    <command label="Citra">%EMULATOR_RETROARCH% -L %CORE_RETROARCH%\citra_libretro.dll %ROM%</command>
    <command label="Citra 2018">%EMULATOR_RETROARCH% -L %CORE_RETROARCH%\citra2018_libretro.dll %ROM%</command>
    <command label="Azahar (Standalone)">%EMULATOR_AZAHAR% %ROM%</command>
    <platform>n3ds</platform>
    <theme>n3ds</theme>
  </system>
  <system>
    <name>n3ds</name>
    <fullname>Nintendo 3DS</fullname>
    <path>%ROMPATH%/n3ds</path>
    <extension>.3ds .3DS .3dsx .3DSX .app .APP .axf .AXF .cci .CCI .cxi .CXI .elf .ELF .7z .7Z .zip .ZIP</extension>
    <command label="Azahar (Standalone)">/usr/bin/bash @EMULATION@/tools/launchers/azahar.sh %ROM%</command>
    <platform>n3ds</platform>
    <theme>n3ds</theme>
  </system>
  <!-- deck system menu -->
  <!-- Steam games (roms/steam, kept up to date by @PRISM_DIR@/prism_sync.py), first in the console row -->
  <system>
    <name>steam</name>
    <fullname>Steam</fullname>
    <systemsortname>0 Steam</systemsortname>
    <path>%ROMPATH%/steam</path>
    <extension>.desktop .sh</extension>
    <command label="Steam (Standalone)">%RUNINBACKGROUND% %ENABLESHORTCUTS% %EMULATOR_OS-SHELL% %ROM%</command>
    <platform>steam</platform>
    <theme>steam</theme>
  </system>
  <system>
    <name>media</name>
    <fullname>Request Movies</fullname>
    <systemsortname>0b Media</systemsortname>
    <path>%ROMPATH%/media</path>
    <extension>.sh</extension>
    <command label="Open">%RUNINBACKGROUND% %ENABLESHORTCUTS% %EMULATOR_OS-SHELL% %ROM%</command>
    <platform>ignore</platform>
    <theme>media</theme>
  </system>
  <!-- Plex in Prism (2026-10-08): stubs made by plex_sync.py, played by plex_play.py (mpv) -->
  <system>
    <name>movies</name>
    <fullname>Movies</fullname>
    <systemsortname>0b1 Movies</systemsortname>
    <path>%ROMPATH%/movies</path>
    <extension>.plex</extension>
    <command label="Play">/usr/bin/python3 @PRISM_DIR@/plex_play.py %ROM%</command>
    <platform>ignore</platform>
    <theme>movies</theme>
  </system>
  <system>
    <name>tv</name>
    <fullname>TV Shows</fullname>
    <systemsortname>0b2 TV Shows</systemsortname>
    <path>%ROMPATH%/tv</path>
    <extension>.plex</extension>
    <command label="Play">/usr/bin/python3 @PRISM_DIR@/plex_play.py %ROM%</command>
    <platform>ignore</platform>
    <theme>tv</theme>
  </system>
  <system>
    <name>music</name>
    <fullname>Music</fullname>
    <systemsortname>0b3 Music</systemsortname>
    <path>%ROMPATH%/music</path>
    <extension>.music</extension>
    <command label="Open">@PRISM_DIR@/deck_music_launch.sh %ROM%</command>
    <platform>ignore</platform>
    <theme>music</theme>
  </system>
  <system>
    <name>foryou</name>
    <fullname>For You</fullname>
    <systemsortname>0a For You</systemsortname>
    <path>%ROMPATH%/foryou</path>
    <extension>.sh</extension>
    <command label="Open">%RUNINBACKGROUND% %ENABLESHORTCUTS% %EMULATOR_OS-SHELL% %ROM%</command>
    <platform>ignore</platform>
    <theme>foryou</theme>
  </system>
